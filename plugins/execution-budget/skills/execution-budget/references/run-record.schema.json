{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cgzhao111/context-relay/blob/main/plugins/execution-budget/skills/execution-budget/references/run-record.schema.json",
  "title": "Execution Budget Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_type", "size_bucket", "mode", "runtime",
    "usage_source", "actual_total_tokens", "actual_duration_minutes", "success",
    "quality_gate_passed", "rework_required", "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_type": {
      "enum": [
        "status_query", "research", "single_file_change", "multi_file_change",
        "debugging", "architecture", "release", "migration", "other"
      ]
    },
    "size_bucket": { "enum": ["small", "medium", "large"] },
    "mode": { "enum": ["quick", "standard", "deep"] },
    "runtime": { "$ref": "#/$defs/runtime" },
    "usage_source": { "enum": ["HOST_REPORTED", "API_RESPONSE", "SYNTHETIC"] },
    "actual_total_tokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "actual_duration_minutes": { "type": "number", "exclusiveMinimum": 0 },
    "success": { "type": "boolean" },
    "quality_gate_passed": { "type": "boolean" },
    "rework_required": { "type": "boolean" },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_family", "host_version_bucket", "model_tier",
        "reasoning_effort", "parallelism"
      ],
      "properties": {
        "host_family": { "enum": ["generic", "codex"] },
        "host_version_bucket": {
          "type": "string",
          "pattern": "^(?:unknown|[0-9]+(?:\\.[0-9]+){0,2})$"
        },
        "model_tier": { "enum": ["unknown", "balanced", "frontier"] },
        "reasoning_effort": { "enum": ["unknown", "low", "medium", "high", "max", "ultra"] },
        "parallelism": { "enum": ["single", "multi"] }
      }
    }
  }
}
